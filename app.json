{
  "expo": {
    "name": "HR Bots",
    "slug": "hrbots",
    "owner": "altraex",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hrbots",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07080b",
    "ios": {
      "bundleIdentifier": "de.feierabendcode.hrbots",
      "supportsTablet": false,
      "appleTeamId": "844JD2257D",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "de",
          "ar"
        ],
        "CFBundleDevelopmentRegion": "en",
        "NSPhotoLibraryUsageDescription": "HR Bots lets you pick a picture (for example a screenshot) to send it to our support team or the helper robot."
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07080b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HR Bots lets you pick a picture (for example a screenshot) to send it to our support team or the helper robot.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e8378f4c-31bd-47d6-80af-9f2ea3a4eb74"
      }
    }
  }
}
